# Install as /etc/bore/server.env, replace every example value, then chmod 600.
# This file is parsed by systemd EnvironmentFile: do not use shell substitutions.

RUST_LOG=info
BORE_BIND_DOMAIN=bore.example.com
BORE_CONTROL_PORT=7835
BORE_MIN_PORT=20000
BORE_MAX_PORT=20100
BORE_MAX_CONNS=4096
BORE_MAX_CARRIERS=8

# Generate independently:
#   openssl rand -base64 48
#   openssl rand -hex 32
BORE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SHARED_SECRET
BORE_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Native bore TLS, public-tunnel --https and SSH-over-TLS.
BORE_CERT_FILE=/etc/bore/tls/fullchain.pem
BORE_KEY_FILE=/etc/bore/tls/privkey.pem
BORE_CONTROL_HSTS="max-age=31536000; includeSubDomains"

# Secret direct UDP, public/vhost/SSH-jump direct QUIC and NAT diagnostics.
BORE_UDP=true
BORE_VHOST_QUIC_PORT=443
BORE_STUN_ALT_PORT=7836
BORE_UDP_MEMORY_BUDGET=2GiB
BORE_UDP_SOCKET_RECV_BUFFER=16MiB
BORE_UDP_SOCKET_SEND_BUFFER=16MiB

# Dynamic web vhosts. Ports match vhost.yml and the nginx snippets.
BORE_VHOST_CONFIG=/etc/bore/vhost.yml
BORE_VHOST_BASE_DOMAIN=bore.example.com
BORE_VHOST_HTTP_PORT=8080
BORE_VHOST_HTTPS_PORT=8444
BORE_VHOST_MODE=both

# Admin-visible access logs generated by bore itself.
BORE_WEBSERVER_LOG=/var/log/bore
BORE_WEBSERVER_LOG_MAX_FILES=7
BORE_WEBSERVER_LOG_MAX_FILE_SIZE=100

# Embedded SSH ingress and native SSH jump hosts. Public keys are recommended.
BORE_SSH_GATEWAY=true
BORE_SSH_JUMP_BASE_DOMAIN=ssh.bore.example.com
BORE_SSH_ADVERTISE_ADDRESS=bore.example.com
BORE_SSH_ADVERTISE_PORT=443
BORE_SSH_HOST_KEY_FILE=/var/lib/bore/ssh_host_key.pem
BORE_SSH_AUTHORIZED_KEYS_DIR=/etc/bore/authorized_keys.d
# BORE_SSH_PASSWORDS_FILE=/etc/bore/passwords
BORE_SSH_BANNER="Authorized use only"

# Browser-to-browser transfer surface (WebSocket relay + WebRTC direct path).
BORE_WEB_TRANSFER_BASE_URL=https://files.bore.example.com

# VPN link broker. The server process brokers links; VPN endpoints create TUNs.
BORE_VPN=true
BORE_VPN_POOL=10.99.0.0/16
BORE_VPN_MAX_LINKS=32
BORE_VPN_HUB_PREFIX=24
