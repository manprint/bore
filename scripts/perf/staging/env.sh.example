# Deployment coordinates for the vhost staging performance campaign.
#
# COPY THIS FILE to `env.sh` OUTSIDE THE REPOSITORY (the harness looks for
# $BORE_PERF_ENV first, then ~/.config/bore-perf/env.sh, then ./env.sh) and
# `chmod 600` it. Secrets are NEVER committed: every value below that is a
# credential is left blank here on purpose and is provided separately.
#
# Re-pointing the whole campaign at a different deployment (a real pre-production
# server, another region, a bigger instance) is exactly this file plus one
# provisioning run — no script edits.

# ---- the bore server under test -------------------------------------------
# Public hostname of the vhost frontend: subdomains are <label>.$BORE_GW
export BORE_GW=bore.example.com
# SSH login for the server host, used only to read NIC counters and to edit the
# compose file when a parameter is varied. Leave BORE_SRV empty to skip every
# server-side step (the throughput measurements still run).
export BORE_SRV=203.0.113.10
export BORE_SRV_USER=ubuntu
# Network interface whose allowance counters are read (AWS Nitro: ens5).
export BORE_SRV_IFACE=ens5
# Path to the docker compose file that runs the server, on the server host.
export BORE_SRV_COMPOSE=/home/ubuntu/bore/docker-compose.yml
export BORE_SRV_CONTAINER=bore-server

# ---- the test VM (provider side, same region as the server) ---------------
export BORE_VM=203.0.113.20
export BORE_VM_USER=ubuntu

# ---- ssh key used for BOTH hosts ------------------------------------------
export BORE_SSH_KEY=$HOME/.ssh/perf.pem

# ---- credentials (PROVIDED SEPARATELY — never commit real values) ---------
# Control URL the provider dials, e.g. https://bore.example.com
export BORE_TO=
# Tunnel secret (bore --secret)
export BORE_SECRET=
# Admin API bearer token (>= 32 chars)
export ADMIN_TOKEN=
# Admin API base, e.g. https://bore.example.com/admin/api/v1
export ADMIN_URL=
# SSH-gateway login used by the `ssh` forwarder flavour
export SSHGW_USER=
export SSHGW_PASS=

# ---- local paths -----------------------------------------------------------
# Where large generated fixtures (1 GiB upload file) are cached.
export BORE_PERF_WORK=${BORE_PERF_WORK:-$HOME/.cache/bore-perf}
# Where results are written.
export BORE_PERF_OUT=${BORE_PERF_OUT:-$PWD/out}
