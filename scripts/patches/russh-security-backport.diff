+    fn kex_ecdh_init(pubkey: [u8; 32]) -> Vec<u8> {
+        let mut payload = vec![msg::KEX_ECDH_INIT];
+        payload.extend_from_slice(&32u32.to_be_bytes());
+        payload.extend_from_slice(&pubkey);
+        payload
